# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Set your local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/history_packers

# Authorized Single Administrator Account (Gmail address)
ADMIN_EMAIL=historypackersandmovers@gmail.com

# JWT Authentication Secrets
JWT_ACCESS_SECRET=history_packers_jwt_access_super_secret_key_2026_xyz
JWT_REFRESH_SECRET=history_packers_jwt_refresh_super_secret_key_2026_abc
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Storage (Provide either CLOUDINARY_URL or discrete credentials below)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration (Optional: system logs gracefully if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=History Packers & Movers <Historypackersandmovers@gmail.com>

